appname               = crewgo
version               = {{VERSION}}
display_name          = 速派
desc                  = 速派（CrewGo）维修人员预约管理系统：预约人提单、维修工看自己的安排、统筹看全员日历。自带本地数据库与定时通知，支持邮件（EmailJS）和微信（PushPlus）推送，不依赖任何外部服务。
source                = thirdparty
platform              = all

maintainer            = {{OWNER}}
maintainer_url        = https://github.com/{{OWNER}}/crewgo
distributor           = {{OWNER}}

os_min_version        = 1.2.0
ctl_stop              = true

desktop_uidir         = ui
desktop_applaunchname = crewgo.Application

service_port          = 8080
checkport             = true

changelog             = 1.0.4：登录 PIN 支持字母、数字、符号（4–32 位，区分大小写），输入框可一键显示/隐藏；首尾空格自动忽略，避免手机键盘误带空格登录失败。1.0.3：容器改用 host 网络，修复桌面图标/域名打开报 HTTP 502。1.0.2：修复镜像地址含大写字母导致安装失败。1.0.0：排期看板、预约单、我的安排、人员与项目管理、邮件与微信通知、定时提醒与派单汇总。
