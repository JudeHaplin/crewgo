appname               = repair-scheduler
version               = {{VERSION}}
display_name          = 维修排班
desc                  = 房屋维修预约与人员排期：预约人提单、维修工看自己的安排、统筹看全员日历。自带本地数据库与定时通知，支持邮件（EmailJS）和微信（PushPlus）推送，不依赖任何外部服务。
source                = thirdparty
platform              = all

maintainer            = {{OWNER}}
maintainer_url        = https://github.com/{{OWNER}}/repair-scheduler
distributor           = {{OWNER}}

os_min_version        = 1.2.0
ctl_stop              = true

desktop_uidir         = ui
desktop_applaunchname = repair-scheduler.Application

service_port          = 8080
checkport             = true

changelog             = 首个版本：排期看板、预约单、我的安排、姓名+PIN 登录、人员与项目管理、邮件与微信通知、每天定时出发提醒与派单汇总。
